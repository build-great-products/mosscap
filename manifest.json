{
  "display_information": {
    "name": "Mosscap Phase 1"
  },
  "features": {
    "bot_user": {
      "display_name": "Mosscap",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "reactions:read",
        "reactions:write",
        "users:read",
        "team:read",
        "files:read",
        "files:write",
        "channels:read",
        "channels:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels"
      ]
    },
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
